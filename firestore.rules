rules_version = '2';

// Mỗi tài khoản Google của phụ huynh chỉ đọc/ghi được dữ liệu trong families/{uid của mình}.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /families/{uid}/kids/{kidId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.stars == 0
        && request.resource.data.totalStars == 0;
      // Số sao không bao giờ âm (đổi quà phải đủ sao)
      allow update: if isOwner(uid)
        && request.resource.data.name == resource.data.name
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0;

      // Lượt chơi và quà đã đổi
      match /{sub}/{docId} {
        allow read, create, update: if isOwner(uid) && sub in ['plays', 'redemptions'];
      }
    }
  }
}
